# Public URL of the deployed site (used for sitemap, robots, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery via Resend (https://resend.com)
# The form returns an error state until all three are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@example.com
CONTACT_FROM_EMAIL="Cendorva Group Website <website@example.com>"
